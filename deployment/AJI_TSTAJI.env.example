# Fichier facultatif pour les paramètres personnels de l'utilisateur.
# L'URL publique de l'API est intégrée au build Windows ; aucun secret d'API
# ou de base de données ne doit être ajouté à ce fichier.

# Facultatif : active le chatbot avec une clé personnelle Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Facultatif : configuration des courriels de confirmation en mode test.
SMTP_EMAIL=
SMTP_MOT_DE_PASSE=
SMTP_SERVEUR=smtp.gmail.com
SMTP_PORT=587
